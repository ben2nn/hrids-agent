{
  "name": "hrids-agent",
  "version": "0.1.0",
  "description": "原创智能体 CLI，借鉴 agentic CLI 架构思想",
  "type": "module",
  "bin": {
    "hrids-agent": "./bin/hrids-agent.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "config.example.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts --craft",
    "gateway": "npm run build:web && tsx src/main.ts --gateway",
    "build": "npm run build --prefix web && tsc",
    "build:web": "npm run build --prefix web",
    "build:core": "tsc",
    "start": "node dist/main.js",
    "prepublishOnly": "npm run build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=test-results.xml",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.11.1",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "glob": "^11.0.0",
    "iconv-lite": "^0.7.3",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "sharp": "^0.35.3",
    "sqlite-vec": "^0.1.9",
    "undici": "^8.7.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.1",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "fast-check": "^4.6.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
