{
  "_comment": "IM 平台配置示例 — 保存到 ~/.hrids-agent/im-platforms.json",
  "platforms": [
    {
      "_comment": "Telegram Bot 配置",
      "platform": "telegram",
      "enabled": false,
      "token": "YOUR_BOT_TOKEN_FROM_BOTFATHER",
      "allowedUsers": [],
      "proxy": ""
    },
    {
      "_comment": "微信个人号配置（需通过 iLink 平台授权）",
      "platform": "weixin",
      "enabled": false,
      "token": "YOUR_ILINK_TOKEN",
      "accountId": "YOUR_WEIXIN_ACCOUNT_ID",
      "allowedUsers": []
    },
    {
      "_comment": "通用 Webhook 配置（任意 HTTP 客户端均可接入）",
      "platform": "webhook",
      "enabled": false,
      "port": 3283,
      "host": "127.0.0.1",
      "secret": "YOUR_WEBHOOK_SECRET"
    }
  ],
  "sessionIdleMinutes": 60,
  "autoSave": true
}
